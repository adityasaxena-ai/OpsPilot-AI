// This is the Prisma schema for OpsPilot AI
// Phase 1 tables — full schema including Phase 2/3 placeholders (commented)
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Severity {
  P1
  P2
  P3
  P4
  P5
}

enum Impact {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum Environment {
  production
  staging
  development
}

enum ServiceTier {
  T1 @map("1")
  T2 @map("2")
  T3 @map("3")
}

enum ServiceStatus {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  SUPPRESSED
}

enum IncidentStatus {
  DETECTED
  TRIAGED
  CORRELATED
  INVESTIGATING
  RCA_IDENTIFIED
  REMEDIATION_PROPOSED
  AWAITING_APPROVAL
  REMEDIATION_APPROVED
  REMEDIATION_EXECUTED
  EXECUTING
  VERIFYING
  RESOLVED
  CLOSED
  FAILED
  ESCALATED
  LEARNING
}

enum EvidenceType {
  METRIC
  LOG
  TRACE
  DEPLOYMENT
  CHANGE
  HISTORICAL_INCIDENT
  RUNBOOK
}

enum RemediationActionType {
  RESTART_SERVICE
  SCALE_SERVICE
  ROLLBACK_DEPLOYMENT
  RETRY_BATCH
  CLEAR_CACHE
}

enum RemediationStatus {
  PROPOSED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
  EXECUTING
  SUCCEEDED
  FAILED
  ROLLED_BACK
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum UserRole {
  VIEWER
  OPERATOR
  INCIDENT_COMMANDER
  ADMIN
  SRE_OPERATOR
  SECURITY_ADMIN
}

enum ActorType {
  USER
  AI
  SYSTEM
  SIMULATOR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum EventType {
  ALERT
  METRIC
  LOG
  DEPLOYMENT
  CHANGE
  HEALTH
}

enum ChaosScenario {
  BAD_DEPLOYMENT
  HIGH_CPU
  MEMORY_LEAK
  DB_CONNECTION_EXHAUSTION
  API_LATENCY
  QUEUE_BACKLOG
  BATCH_FAILURE
  DISK_FULL
  DEPENDENCY_FAILURE
  CERT_EXPIRY
}

enum AssetType {
  MODEL
  AGENT
  PROMPT
  KNOWLEDGE_SOURCE
}

enum LifecycleStage {
  PROPOSED
  EVALUATED
  APPROVED
  LIVE
  UNDER_REVIEW
  RETIRED
}

// ─────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @default("") @map("password_hash")
  email        String?  @unique
  name         String?
  role         UserRole @default(VIEWER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  assignedIncidents            Incident[]                 @relation("AssignedIncidents")
  approvalRequests             Approval[]                 @relation("ApprovalRequester")
  approvalResponses            Approval[]                 @relation("ApprovalResponder")
  auditLogs                    AuditLog[]
  governanceAssessments        GovernanceRiskAssessment[]
  governanceApprovalRequests   GovernanceApproval[]       @relation("GovernanceRequestedBy")
  governanceApprovalResponses  GovernanceApproval[]       @relation("GovernanceApprovedBy")
  driftEventReviews            DriftEvent[]               @relation("DriftEventReviewedBy")
  aiIncidentTimelineEntries    AiIncidentTimelineEntry[]  @relation("AiIncidentTimelineActor")
  predictionReviews            Prediction[]               @relation("PredictionReviewedBy")
  createdKnowledgeSources      KnowledgeSource[]          @relation("KnowledgeSourceCreatedBy")

  @@map("users")
}

// ─────────────────────────────────────────────
// Service Topology
// ─────────────────────────────────────────────

model Service {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String
  tier         ServiceTier
  environment  Environment   @default(production)
  ownerTeam    String        @map("owner_team")
  ownerEmail   String        @map("owner_email")
  status       ServiceStatus @default(UNKNOWN)
  healthScore  Float         @default(100) @map("health_score")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  dependsOn     ServiceDependency[] @relation("ServiceDependencies")
  dependedOnBy  ServiceDependency[] @relation("DependedOnBy")
  alerts        Alert[]
  incidents     Incident[]
  runbooks      Runbook[]
  thresholdRules ThresholdRule[]
  simState      SimService?
  predictionMonitors PredictionMonitor[]
  governedAssets GovernedAsset[]

  @@map("services")
}

model ServiceDependency {
  id             String   @id @default(cuid())
  serviceId      String   @map("service_id")
  dependsOnId    String   @map("depends_on_id")
  dependencyType String   @default("HARD") @map("dependency_type")
  createdAt      DateTime @default(now()) @map("created_at")

  service   Service @relation("ServiceDependencies", fields: [serviceId], references: [id], onDelete: Cascade)
  dependsOn Service @relation("DependedOnBy", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([serviceId, dependsOnId])
  @@map("service_dependencies")
}

// ─────────────────────────────────────────────
// Events & Alerts
// ─────────────────────────────────────────────

model Event {
  id            String      @id @default(cuid())
  source        String
  eventType     EventType   @map("event_type")
  severity      Severity
  serviceId     String      @map("service_id")
  environment   Environment
  fingerprint   String
  labels        Json        @default("{}")
  payload       Json        @default("{}")
  rawPayload    Json?       @map("raw_payload")
  normalizedAt  DateTime?   @map("normalized_at")
  isDuplicate   Boolean     @default(false) @map("is_duplicate")
  duplicateOfId String?     @map("duplicate_of_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  alert Alert?

  @@index([fingerprint])
  @@index([serviceId])
  @@index([createdAt])
  @@map("events")
}

model Alert {
  id              String      @id @default(cuid())
  eventId         String?     @unique @map("event_id")
  serviceId       String      @map("service_id")
  title           String
  description     String
  severity        Severity
  status          AlertStatus @default(ACTIVE)
  fingerprint     String
  labels          Json        @default("{}")
  firstSeenAt     DateTime    @map("first_seen_at")
  lastSeenAt      DateTime    @map("last_seen_at")
  occurrenceCount Int         @default(1) @map("occurrence_count")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  event          Event?           @relation(fields: [eventId], references: [id])
  service        Service          @relation(fields: [serviceId], references: [id])
  alertGroupMemberships AlertGroupMember[]

  @@index([serviceId])
  @@index([status])
  @@index([fingerprint])
  @@map("alerts")
}

model AlertGroup {
  id                String   @id @default(cuid())
  incidentId        String?  @map("incident_id")
  correlationReason String   @map("correlation_reason")
  createdAt         DateTime @default(now()) @map("created_at")

  incident Incident?          @relation(fields: [incidentId], references: [id])
  members  AlertGroupMember[]

  @@map("alert_groups")
}

model AlertGroupMember {
  alertGroupId String @map("alert_group_id")
  alertId      String @map("alert_id")

  alertGroup AlertGroup @relation(fields: [alertGroupId], references: [id], onDelete: Cascade)
  alert      Alert      @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@id([alertGroupId, alertId])
  @@map("alert_group_members")
}

// ─────────────────────────────────────────────
// Incidents
// ─────────────────────────────────────────────

model Incident {
  id                  String         @id @default(cuid())
  title               String
  description         String
  severity            Severity
  status              IncidentStatus @default(DETECTED)
  serviceId           String         @map("service_id")
  environment         Environment    @default(production)
  assignedToId        String?        @map("assigned_to_id")
  aiTriageConfidence  Float?         @map("ai_triage_confidence")
  aiTriageResult      Json?          @map("ai_triage_result")
  rcaResult           Json?          @map("rca_result")
  detectedAt          DateTime       @map("detected_at")
  triagedAt           DateTime?      @map("triaged_at")
  resolvedAt          DateTime?      @map("resolved_at")
  mttdSeconds         Int?           @map("mttd_seconds")
  mttaSeconds         Int?           @map("mtta_seconds")
  mttrSeconds         Int?           @map("mttr_seconds")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  service           Service             @relation(fields: [serviceId], references: [id])
  assignedTo        User?               @relation("AssignedIncidents", fields: [assignedToId], references: [id])
  alertGroups       AlertGroup[]
  incidentEvents    IncidentEvent[]
  evidence          Evidence[]
  investigations    Investigation[]
  rcaResults        RCAResult[]
  aiIncidents       AiIncident[]
  remediations      RemediationAction[]
  approvals         Approval[]
  postmortem        Postmortem?
  auditLogs         AuditLog[]

  @@index([status])
  @@index([serviceId])
  @@index([severity])
  @@index([detectedAt])
  @@map("incidents")
}

model IncidentEvent {
  id          String    @id @default(cuid())
  incidentId  String    @map("incident_id")
  eventType   String    @map("event_type")
  actorId     String?   @map("actor_id")
  actorType   ActorType @map("actor_type")
  description String
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("incident_events")
}

// ─────────────────────────────────────────────
// Evidence & Investigation (Phase 2 ready)
// ─────────────────────────────────────────────

model Evidence {
  id            String       @id @default(cuid())
  incidentId    String       @map("incident_id")
  evidenceType  EvidenceType @map("evidence_type")
  source        String
  title         String
  content       String
  data          Json         @default("{}")
  relevanceScore Float       @default(0.5) @map("relevance_score")
  collectedAt   DateTime     @map("collected_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("evidence")
}

model Investigation {
  id          String   @id @default(cuid())
  incidentId  String   @map("incident_id")
  agentName   String   @map("agent_name")
  input       Json
  output      Json
  confidence  Float    @default(0)
  durationMs  Int      @default(0) @map("duration_ms")
  modelUsed   String?  @map("model_used")
  tokenCount  Int      @default(0) @map("token_count")
  createdAt   DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("investigations")
}

model RCAResult {
  id                String   @id @default(cuid())
  incidentId        String   @map("incident_id")
  probableCause     String   @map("probable_cause")
  confidence        Float    @default(0)
  evidenceIds       String[] @map("evidence_ids")
  recommendedActions Json    @default("[]") @map("recommended_actions")
  alternativeCauses Json    @default("[]") @map("alternative_causes")
  supportingContext String   @map("supporting_context")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@map("rca_results")
}

// ─────────────────────────────────────────────
// Remediation & Approvals (Phase 3 ready)
// ─────────────────────────────────────────────

enum VerificationVerdict {
  VERIFIED_SUCCESS
  INCONCLUSIVE
  VERIFIED_FAILURE
}

model RemediationAction {
  id                     String                @id @default(cuid())
  incidentId             String                @map("incident_id")
  remediationOptionSetId String?               @map("remediation_option_set_id")
  actionType             RemediationActionType @map("action_type")
  actionParams           Json                  @default("{}") @map("action_params")
  status                 RemediationStatus     @default(PROPOSED)
  riskScore              Int                   @default(0) @map("risk_score")
  riskLevel              RiskLevel             @default(LOW) @map("risk_level")
  riskFactors            Json                  @default("{}") @map("risk_factors")
  proposedByAi           Boolean               @default(true) @map("proposed_by_ai")
  proposedAt             DateTime              @default(now()) @map("proposed_at")
  executedAt             DateTime?             @map("executed_at")
  completedAt            DateTime?             @map("completed_at")
  executionLog           String?               @map("execution_log")
  successCriteria        Json?                 @map("success_criteria")
  verificationVerdict    VerificationVerdict?  @map("verification_verdict")
  verifiedAt             DateTime?             @map("verified_at")
  verificationNotes      String?               @map("verification_notes")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  incident  Incident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  approval  Approval?
  baseline  RemediationBaseline?
  auditLogs AuditLog[]

  @@index([incidentId])
  @@index([remediationOptionSetId])
  @@index([status])
  @@map("remediation_actions")
}

model RemediationBaseline {
  id                  String            @id @default(cuid())
  remediationActionId String            @unique @map("remediation_action_id")
  capturedMetrics     Json              @map("captured_metrics")
  capturedAt          DateTime          @default(now()) @map("captured_at")
  createdAt           DateTime          @default(now()) @map("created_at")

  remediationAction   RemediationAction @relation(fields: [remediationActionId], references: [id], onDelete: Cascade)

  @@map("remediation_baselines")
}

model Approval {
  id                    String         @id @default(cuid())
  remediationActionId   String         @unique @map("remediation_action_id")
  incidentId            String         @map("incident_id")
  requestedById         String?        @map("requested_by_id")
  approvedById          String?        @map("approved_by_id")
  status                ApprovalStatus @default(PENDING)
  aiRecommendation      String?        @map("ai_recommendation")
  riskSummary           String?        @map("risk_summary")
  requestedAt           DateTime       @default(now()) @map("requested_at")
  respondedAt           DateTime?      @map("responded_at")
  expiresAt             DateTime       @map("expires_at")
  rejectionReason       String?        @map("rejection_reason")
  createdAt             DateTime       @default(now()) @map("created_at")

  remediationAction RemediationAction @relation(fields: [remediationActionId], references: [id], onDelete: Cascade)
  incident          Incident          @relation(fields: [incidentId], references: [id])
  requestedBy       User?             @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approvedBy        User?             @relation("ApprovalResponder", fields: [approvedById], references: [id])

  @@index([incidentId])
  @@index([status])
  @@map("approvals")
}

// ─────────────────────────────────────────────
// Policy Engine (Phase 3 ready)
// ─────────────────────────────────────────────

model Policy {
  id                String                @id @default(cuid())
  name              String
  description       String
  actionType        RemediationActionType @map("action_type")
  environment       Environment           @default(production)
  serviceTier       ServiceTier           @map("service_tier")
  maxRiskScore      Int                   @default(30) @map("max_risk_score")
  requiresApproval  Boolean               @default(true) @map("requires_approval")
  isAutonomous      Boolean               @default(false) @map("is_autonomous")
  maxRetries        Int                   @default(1) @map("max_retries")
  conditions        Json                  @default("{}")
  isActive          Boolean               @default(true) @map("is_active")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@map("policies")
}

// ─────────────────────────────────────────────
// Knowledge Base (Phase 2 ready)
// ─────────────────────────────────────────────

model Runbook {
  id          String   @id @default(cuid())
  title       String
  description String
  serviceId   String?  @map("service_id")
  content     String
  tags        String[]
  version     String   @default("1.0")
  authorId    String?  @map("author_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  service Service? @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@map("runbooks")
}

// ─────────────────────────────────────────────
// Postmortems
// ─────────────────────────────────────────────

model Postmortem {
  id                      String   @id @default(cuid())
  incidentId              String   @unique @map("incident_id")
  summary                 String
  businessImpact          String   @map("business_impact")
  timeline                Json     @default("[]")
  rootCause               String   @map("root_cause")
  detectionMethod         String   @map("detection_method")
  remediationSummary      String   @map("remediation_summary")
  verificationSummary     String   @map("verification_summary")
  preventiveActions       Json     @default("[]") @map("preventive_actions")
  automationEffectiveness String   @map("automation_effectiveness")
  generatedBy             String   @default("AI") @map("generated_by")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@map("postmortems")
}

// ─────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────

model AuditLog {
  id                  String    @id @default(cuid())
  actorId             String?   @map("actor_id")
  actorType           ActorType @map("actor_type")
  action              String
  targetType          String    @map("target_type")
  targetId            String    @map("target_id")
  incidentId          String?   @map("incident_id")
  metadata            Json      @default("{}")
  aiConfidence        Float?    @map("ai_confidence")
  riskScore           Int?      @map("risk_score")
  approvalId          String?   @map("approval_id")
  remediationActionId String?   @map("remediation_action_id")
  result              String?
  createdAt           DateTime  @default(now()) @map("created_at")

  actor               User?              @relation(fields: [actorId], references: [id])
  incident            Incident?          @relation(fields: [incidentId], references: [id])
  remediationAction   RemediationAction? @relation(fields: [remediationActionId], references: [id])

  @@index([incidentId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Simulator State
// ─────────────────────────────────────────────

model SimService {
  id                   String         @id @default(cuid())
  serviceId            String         @unique @map("service_id")
  cpuPercent           Float          @default(20) @map("cpu_percent")
  memoryPercent        Float          @default(40) @map("memory_percent")
  latencyP50Ms         Float          @default(50) @map("latency_p50_ms")
  latencyP99Ms         Float          @default(150) @map("latency_p99_ms")
  errorRatePercent     Float          @default(0.1) @map("error_rate_percent")
  throughputRps        Float          @default(100) @map("throughput_rps")
  dbConnectionsActive  Int            @default(10) @map("db_connections_active")
  dbConnectionsMax     Int            @default(100) @map("db_connections_max")
  queueDepth           Int            @default(0) @map("queue_depth")
  isHealthy            Boolean        @default(true) @map("is_healthy")
  failureScenario      ChaosScenario? @map("failure_scenario")
  failureStartedAt     DateTime?      @map("failure_started_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("sim_services")
}

model SimDeployment {
  id              String    @id @default(cuid())
  serviceId       String    @map("service_id")
  version         String
  commitSha       String    @map("commit_sha")
  deployedBy      String    @map("deployed_by")
  isBadDeployment Boolean   @default(false) @map("is_bad_deployment")
  failureType     String?   @map("failure_type")
  deployedAt      DateTime  @default(now()) @map("deployed_at")

  @@index([serviceId])
  @@index([deployedAt])
  @@map("sim_deployments")
}

model SimLog {
  id         String   @id @default(cuid())
  serviceId  String   @map("service_id")
  level      String
  message    String
  traceId    String?  @map("trace_id")
  spanId     String?  @map("span_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([serviceId])
  @@index([createdAt])
  @@map("sim_logs")
}

// ─────────────────────────────────────────────
// Threshold Rules (Phase 2 Detection Engine)
// ─────────────────────────────────────────────

model ThresholdRule {
  id          String   @id @default(cuid())
  name        String
  metric      String   // cpuPercent, memoryPercent, errorRatePercent, latencyP99Ms, dbConnectionsActive, queueDepth
  operator    String   // GT, GTE, LT, LTE, EQ
  threshold   Float
  durationSec Int      @default(0) @map("duration_sec")
  severity    Severity @default(P2)
  serviceId   String?  @map("service_id")
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([serviceId])
  @@map("threshold_rules")
}

// ─────────────────────────────────────────────
// AI Governance Control Center (Sim 2.0)
// ─────────────────────────────────────────────

model GovernedAsset {
  id             String         @id @default(cuid())
  name           String
  assetType      AssetType      @map("asset_type")
  description    String
  ownerTeam      String         @map("owner_team")
  ownerEmail     String         @map("owner_email")
  purpose        String
  lifecycleStage LifecycleStage @default(PROPOSED) @map("lifecycle_stage")
  serviceId      String?        @map("service_id")
  riskLevel      RiskLevel      @default(LOW) @map("risk_level")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  service         Service?                  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  riskAssessments GovernanceRiskAssessment[]
  approvals       GovernanceApproval[]
  driftMonitors   DriftMonitor[]
  driftEvents     DriftEvent[]
  aiIncidents     AiIncident[]

  @@index([serviceId])
  @@map("governed_assets")
}

model GovernanceRiskAssessment {
  id                  String        @id @default(cuid())
  governedAssetId     String        @map("governed_asset_id")
  fairnessNotes       String?       @map("fairness_notes")
  transparencyNotes   String?       @map("transparency_notes")
  privacyNotes        String?       @map("privacy_notes")
  accountabilityNotes String?       @map("accountability_notes")
  reliabilityNotes    String?       @map("reliability_notes")
  securityNotes       String?       @map("security_notes")
  riskScore           Int           @map("risk_score")
  riskLevel           RiskLevel     @map("risk_level")
  assessedById        String?       @map("assessed_by_id")
  assessedBySubject   String?       @map("assessed_by_subject")
  assessedAt          DateTime      @default(now()) @map("assessed_at")
  createdAt           DateTime      @default(now()) @map("created_at")

  asset               GovernedAsset @relation(fields: [governedAssetId], references: [id], onDelete: Cascade)
  assessedBy          User?         @relation(fields: [assessedById], references: [id], onDelete: SetNull)

  @@index([governedAssetId])
  @@map("governance_risk_assessments")
}

model GovernancePolicy {
  id                  String    @id @default(cuid())
  name                String
  description         String
  appliesTo           AssetType @map("applies_to")
  requiresApprovalFor String[]  @map("requires_approval_for")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("governance_policies")
}

model GovernanceApproval {
  id              String         @id @default(cuid())
  governedAssetId String         @map("governed_asset_id")
  targetStage     LifecycleStage @map("target_stage")
  status          ApprovalStatus @default(PENDING)
  requestedById      String?        @map("requested_by_id")
  requestedBySubject String?        @map("requested_by_subject")
  approvedById       String?        @map("approved_by_id")
  approvedBySubject  String?        @map("approved_by_subject")
  requestedAt        DateTime       @default(now()) @map("requested_at")
  respondedAt     DateTime?      @map("responded_at")
  expiresAt       DateTime?      @map("expires_at")
  rejectionReason String?        @map("rejection_reason")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  asset           GovernedAsset  @relation(fields: [governedAssetId], references: [id], onDelete: Cascade)
  requestedBy     User?          @relation("GovernanceRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy      User?          @relation("GovernanceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([governedAssetId])
  @@map("governance_approvals")
}

// ─────────────────────────────────────────────
// Model Drift Detection & AI Incident Management (Sim 2.0 S2-FR-04 & S2-FR-05)
// ─────────────────────────────────────────────

enum DriftMethod {
  PSI
  ERROR_RATE_COMPARISON
}

enum DriftState {
  HEALTHY
  WARNING
  DRIFT_DETECTED
  UNDER_REVIEW
  VALIDATION_REMEDIATION
  RESOLVED
  ESCALATED
}

enum AiIncidentType {
  MODEL_DRIFT
  HARMFUL_OUTPUT
  UNEXPECTED_BEHAVIOR
  RELIABILITY_FAILURE
  POLICY_VIOLATION
  GOVERNANCE_CONTROL_FAILURE
  DATA_ISSUE
  PERFORMANCE_DEGRADATION
  HALLUCINATION
}

enum AiIncidentStatus {
  DETECTED
  TRIAGED
  UNDER_INVESTIGATION
  UNDER_REVIEW
  REMEDIATION_PLANNED
  REMEDIATION_IN_PROGRESS
  MONITORING
  RESOLVED
  CLOSED
}

enum AiIncidentTimelineEntryType {
  IMPACT
  EVIDENCE
  CONTAINMENT
  INVESTIGATION
  REMEDIATION
  APPROVAL
  CLOSURE
}

model DriftMonitor {
  id               String        @id @default(cuid())
  governedAssetId  String        @map("governed_asset_id")
  metricName       String        @map("metric_name")
  method           DriftMethod
  // Expected baselineSnapshot format per method:
  // - PSI: number[] (e.g. [0.1, 0.2, 0.4, 0.2, 0.1] - probability distribution per bin)
  // - ERROR_RATE_COMPARISON: number (e.g. 0.02 - reference baseline error rate)
  baselineSnapshot Json          @map("baseline_snapshot")
  // Threshold score above which drift is flagged:
  // - PSI: >0.1 moderate, >0.25 significant (configurable threshold float value)
  // - ERROR_RATE_COMPARISON: e.g. 0.05 absolute delta or relative multiplier
  threshold        Float
  isEnabled        Boolean       @default(true) @map("is_enabled")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  asset       GovernedAsset @relation(fields: [governedAssetId], references: [id], onDelete: Cascade)
  driftEvents DriftEvent[]

  @@index([governedAssetId])
  @@map("drift_monitors")
}

model DriftEvent {
  id                String        @id @default(cuid())
  driftMonitorId    String        @map("drift_monitor_id")
  governedAssetId   String        @map("governed_asset_id")
  state             DriftState    @default(HEALTHY)
  metricName        String        @map("metric_name")
  baselineValue     Json          @map("baseline_value")
  currentValue      Json          @map("current_value")
  computedScore     Float         @map("computed_score")
  threshold         Float
  detectedAt        DateTime?     @map("detected_at")
  resolvedAt        DateTime?     @map("resolved_at")
  reviewedById      String?       @map("reviewed_by_id")
  reviewedBySubject String?       @map("reviewed_by_subject")
  reviewNotes       String?       @map("review_notes")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  monitor     DriftMonitor  @relation(fields: [driftMonitorId], references: [id], onDelete: Cascade)
  asset       GovernedAsset @relation(fields: [governedAssetId], references: [id], onDelete: Cascade)
  reviewedBy  User?         @relation("DriftEventReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  aiIncidents AiIncident[]

  @@index([driftMonitorId])
  @@index([governedAssetId])
  @@map("drift_events")
}

model AiIncident {
  id                String           @id @default(cuid())
  governedAssetId   String?          @map("governed_asset_id")
  relatedIncidentId String?          @map("related_incident_id")
  driftEventId      String?          @map("drift_event_id")
  incidentType      AiIncidentType   @map("incident_type")
  title             String
  description       String
  status            AiIncidentStatus @default(DETECTED)
  severity          Severity
  detectedAt        DateTime         @default(now()) @map("detected_at")
  resolvedAt        DateTime?        @map("resolved_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  asset           GovernedAsset?            @relation(fields: [governedAssetId], references: [id], onDelete: SetNull)
  relatedIncident Incident?                 @relation(fields: [relatedIncidentId], references: [id], onDelete: SetNull)
  driftEvent      DriftEvent?               @relation(fields: [driftEventId], references: [id], onDelete: SetNull)
  timelineEntries AiIncidentTimelineEntry[]

  @@index([governedAssetId])
  @@index([relatedIncidentId])
  @@index([driftEventId])
  @@map("ai_incidents")
}

model AiIncidentTimelineEntry {
  id           String                      @id @default(cuid())
  aiIncidentId String                      @map("ai_incident_id")
  entryType    AiIncidentTimelineEntryType @map("entry_type")
  description  String
  metadata     Json                        @default("{}")
  actorId      String?                     @map("actor_id")
  actorSubject String?                     @map("actor_subject")
  createdAt    DateTime                    @default(now()) @map("created_at")

  aiIncident AiIncident @relation(fields: [aiIncidentId], references: [id], onDelete: Cascade)
  actor      User?      @relation("AiIncidentTimelineActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([aiIncidentId])
  @@map("ai_incident_timeline_entries")
}

// ─────────────────────────────────────────────
// Predictive Intelligence (Sim 2.0 Operational Risk)
// ─────────────────────────────────────────────

enum PredictionMethod {
  TREND_SLOPE
}

enum PredictionStatus {
  ACTIVE
  EXPIRED
  INSUFFICIENT_EVIDENCE
}

model PredictionMonitor {
  id             String           @id @default(cuid())
  serviceId      String           @map("service_id")
  metricName     String           @map("metric_name")
  threshold      Float
  horizonMinutes Int              @map("horizon_minutes")
  minimumSamples Int              @default(5) @map("minimum_samples")
  method         PredictionMethod @default(TREND_SLOPE)
  isEnabled      Boolean          @default(true) @map("is_enabled")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  predictions Prediction[]

  @@index([serviceId])
  @@map("prediction_monitors")
}

model Prediction {
  id                  String           @id @default(cuid())
  predictionMonitorId String           @map("prediction_monitor_id")
  serviceId           String           @map("service_id")
  metricName          String           @map("metric_name")
  status              PredictionStatus
  projectedValue      Float?           @map("projected_value")
  confidence          Float            // 0 to 1
  horizonMinutes      Int              @map("horizon_minutes")
  threshold           Float
  evidenceSamples     Json             @map("evidence_samples")
  trendSlope          Float?           @map("trend_slope")
  explanation         String
  predictedAt         DateTime         @default(now()) @map("predicted_at")
  expiresAt           DateTime         @map("expires_at")
  reviewedById        String?          @map("reviewed_by_id")
  reviewedBySubject   String?          @map("reviewed_by_subject")
  reviewNotes         String?          @map("review_notes")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  predictionMonitor PredictionMonitor @relation(fields: [predictionMonitorId], references: [id], onDelete: Cascade)
  reviewedBy        User?             @relation("PredictionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([predictionMonitorId])
  @@index([serviceId])
  @@index([status])
  @@map("predictions")
}

// ─────────────────────────────────────────────
// Grounded Retrieval & RAG Knowledge Base (Sim 2.0 S2-FR-10)
// ─────────────────────────────────────────────

enum KnowledgeSourceType {
  RUNBOOK
  POLICY
  ARCHITECTURE_DOC
  INCIDENT_HISTORY
  GOVERNANCE_POLICY
}

model KnowledgeSource {
  id               String              @id @default(cuid())
  title            String
  sourceType       KnowledgeSourceType @map("source_type")
  isActive         Boolean             @default(true) @map("is_active")
  isPublic         Boolean             @default(true) @map("is_public")
  createdById      String?             @map("created_by_id")
  createdBySubject String?             @map("created_by_subject")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  createdBy User?            @relation("KnowledgeSourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  chunks    KnowledgeChunk[]

  @@index([sourceType])
  @@index([isActive])
  @@index([isPublic])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id                String          @id @default(cuid())
  knowledgeSourceId String          @map("knowledge_source_id")
  chunkIndex        Int             @map("chunk_index")
  content           String
  embedding         Json            // Array of floats (number[])
  createdAt         DateTime        @default(now()) @map("created_at")

  knowledgeSource KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)

  @@index([knowledgeSourceId])
  @@map("knowledge_chunks")
}


