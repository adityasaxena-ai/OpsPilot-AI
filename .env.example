# ==========================================
# OpsPilot AI — Environment Configuration
# ==========================================

# ── Application Configuration ──────────────────────
NODE_ENV=production
PORT=3001
WEB_URL=https://opspilot-web-wf6g.onrender.com
API_URL=https://opspilot-ai-0seb.onrender.com
VITE_API_URL=https://opspilot-ai-0seb.onrender.com

# Umami Cloud website ID (public, not a secret). Leave EMPTY locally → no analytics script loaded.
VITE_UMAMI_WEBSITE_ID=

JWT_SECRET="example_shared_jwt_secret_min_32_bytes_long_string_for_dev_only"

# Optional dev-only authentication bypass (MUST be false/unset in production)
# ENABLE_DEMO_AUTH=false


# ── Database Configuration ────────────────────────
# Local Docker PostgreSQL (Default for local development)
DATABASE_URL="postgresql://opspilot:opspilot@localhost:5432/opspilot?sslmode=disable"
# Non-pooled URL for prisma migrate. Local: same as DATABASE_URL. Prod: Neon direct (no -pooler) host, set ONLY in GitHub environment `production`.
DIRECT_URL="postgresql://opspilot:opspilot@localhost:5432/opspilot?sslmode=disable"
TEST_DATABASE_URL="postgresql://opspilot:opspilot@localhost:5432/opspilot_test?sslmode=disable"

# Upstash Managed Serverless Redis (https://upstash.com)
REDIS_URL="rediss://default:PASS@xyz.upstash.io:6379"

# ── Telemetry & AI Provider Settings ──────────────
TELEMETRY_PROVIDER=mock
AI_PROVIDER=mock
# Required (no default) when AI_PROVIDER=gemini and an ENABLE_LLM_* flag is true
AI_MODEL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
GEMINI_API_KEY=
# Phase 4 L20: real LLM calls are off unless explicitly enabled
ENABLE_LLM_GENERATION=false
ENABLE_LLM_EMBEDDINGS=false
# L12: MockProvider only with this flag; refused on Render
AI_ALLOW_MOCK=false

# ── Simulation & Autonomous Governance ───────────
SIMULATION_MODE=true
SIMULATOR_TICK_INTERVAL_MS=15000
ENABLE_AUTONOMOUS_REMEDIATION=true
APPROVAL_EXPIRY_MINUTES=15
MAX_REMEDIATION_RISK_AUTONOMOUS=30

# ── Observability ────────────────────────────────
LOG_LEVEL=info
