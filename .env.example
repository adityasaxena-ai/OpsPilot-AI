# ==========================================
# OpsPilot AI — Environment Configuration
# ==========================================

# ── Application Configuration ──────────────────────
NODE_ENV=production
PORT=3001
WEB_URL=https://opspilot-web.vercel.app
API_URL=https://opspilot-api.up.railway.app
VITE_API_URL=https://opspilot-api.up.railway.app
JWT_SECRET="example_shared_jwt_secret_min_32_bytes_long_string_for_dev_only"

# Optional dev-only authentication bypass (MUST be false/unset in production)
# ENABLE_DEMO_AUTH=false


# ── Database Configuration ────────────────────────
# Local Docker PostgreSQL (Default for local development)
DATABASE_URL="postgresql://opspilot:opspilot@localhost:5432/opspilot?sslmode=disable"
TEST_DATABASE_URL="postgresql://opspilot:opspilot@localhost:5432/opspilot_test?sslmode=disable"

# Upstash Managed Serverless Redis (https://upstash.com)
REDIS_URL="rediss://default:PASS@xyz.upstash.io:6379"

# ── Telemetry & AI Provider Settings ──────────────
TELEMETRY_PROVIDER=mock
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
GEMINI_API_KEY=

# ── Simulation & Autonomous Governance ───────────
SIMULATION_MODE=true
SIMULATOR_TICK_INTERVAL_MS=15000
ENABLE_AUTONOMOUS_REMEDIATION=true
APPROVAL_EXPIRY_MINUTES=15
MAX_REMEDIATION_RISK_AUTONOMOUS=30

# ── Observability ────────────────────────────────
LOG_LEVEL=info
