{
  "name": "opspilot",
  "version": "0.1.0",
  "private": true,
  "description": "OpsPilot AI — Autonomous IT Operations Control Tower",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npx pnpm --parallel --filter @opspilot/api --filter @opspilot/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "openapi:export": "pnpm --filter @opspilot/api exec tsx ../../scripts/export-openapi.ts",
    "openapi:lint": "npx @redocly/cli lint openapi.json --config .redocly.yaml"
  },

  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^9.8.0",
    "prettier": "^3.3.3",
    "puppeteer": "^25.9.0",
    "tsx": "^4.16.5",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "prisma": "^5.17.0"
  },
  "overrides": {
    "find-my-way": ">=9.6.1",
    "@fastify/static": ">=10.1.2",
    "nanoid": ">=3.3.18",
    "cross-spawn": ">=7.0.6",
    "fastify": ">=5.7.3",
    "vite": ">=5.4.14",
    "react-router-dom": "^6.30.5",
    "express": ">=4.21.2"
  }
}
